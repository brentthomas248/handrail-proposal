---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '../styles/global.css';
import MotionToggle from '../components/MotionToggle';
import regularFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
interface Props {
  title: string;
  description?: string;
  document?: boolean;
}
const {
  title,
  description = 'A proposed partnership between Brent Showalter and Handrail. Two paths to begin, compensation tied to collections, and a clear written commitment.',
  document = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href={regularFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#edf0f2" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A commitment built around results. Brent Showalter and Handrail."
    />
    <meta
      property="og:image"
      content={new URL(`${base}social.png`, Astro.site).toString()}
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class:list={[document && 'document-page']}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="site-header">
      <a
        class="identity"
        href={base}
        aria-label="Brent Showalter and Handrail proposal home"
      >
        <svg
          class="identity-mark"
          viewBox="0 0 32 34"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 29V4l13 6 13-6v25l-13-6L3 29Z"
            stroke="currentColor"
            stroke-width="1.5"
          />
          <path d="M16 10v13" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span>
          Brent Showalter <span class="identity-divider">/</span> Handrail
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#structure`}>The structure</a>
        <a
          href={`${base}agreement/`}
          aria-current={document ? 'page' : undefined}
        >
          Read the agreement <span aria-hidden="true">↗</span>
        </a>
        {!document && <MotionToggle client:load />}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <a class="footer-signature" href={base}>
        Brent Showalter<span>Built around a real conversation.</span>
      </a>
      <div>
        <span>Unsigned proposal · September 2026</span>
        <a
          href="https://github.com/brentthomas248"
          target="_blank"
          rel="noreferrer"
        >
          View my GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </footer>
    <script>
      const bar = document.querySelector<HTMLElement>('.reading-progress');
      const update = () => {
        const available = document.documentElement.scrollHeight - innerHeight;
        if (bar)
          bar.style.transform = `scaleX(${available > 0 ? scrollY / available : 0})`;
      };
      addEventListener('scroll', update, { passive: true });
      update();
    </script>
  </body>
</html>

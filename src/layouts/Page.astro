---
import '@fontsource-variable/inter';
import '@fontsource/playfair-display/400-italic.css';
import '../styles/global.css';
import { flyerCopy } from '../content/proposal';
import regularFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
interface Props {
  title: string;
  description?: string;
  document?: boolean;
  currentPage?: 'proposal' | 'notes' | 'resume';
}
const {
  title,
  description = `${flyerCopy.cover.statement} Room to grow with Handrail. A proposal by Brent Showalter.`,
  document = false,
  currentPage = document ? 'notes' : 'proposal',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-presentation="read">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={regularFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ebe4d8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${flyerCopy.cover.statement} A proposal for Handrail.`}
    />
    <meta
      property="og:image"
      content={new URL(`${base}social.png`, Astro.site).toString()}
    />
    <link rel="icon" href={`${base}handrail-logo.png`} type="image/png" />
    <title>{title}</title>
    {!document && <script is:inline>
      try {
        const requestedRead =
          new URLSearchParams(location.search).get('view') === 'read';
        if (
          !requestedRead &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          localStorage.getItem('proposal-presentation') !== 'read'
        ) {
          document.documentElement.dataset.presentation = 'tour';
          // A failed module or font request must leave a readable proposal.
          setTimeout(() => {
            if (!document.documentElement.classList.contains('camera-ready'))
              document.documentElement.dataset.presentation = 'read';
          }, 4000);
        }
      } catch {
        /* Reading mode is the safe default when storage is unavailable. */
      }
    </script>}
  </head>
  <body class:list={[document && 'document-page']}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a
        class="identity"
        href={base}
        aria-label="Handrail and Brent Showalter proposal home"
      >
        <img
          class="identity-logo"
          src={`${base}handrail-logo.png`}
          width="1397"
          height="392"
          alt="Handrail — Support your climb"
        />
        <span class="identity-author">
          Proposal by
          <br />
          <strong>Brent Showalter</strong>
        </span>
      </a>
      <nav class="reading-navigation" aria-label="Main navigation">
        <a
          class="notes-navigation"
          href={`${base}agreement/`}
          aria-current={currentPage === 'notes' ? 'page' : undefined}
        >
          Proposal notes
        </a>
        {!document && (
          <>
            <button type="button" id="reading-mode" aria-pressed="false" hidden>
              Read normally
            </button>
            <span id="reading-explanation" class="sr-only"></span>
          </>
        )}
        {document && <a href={base}>The proposal</a>}
      </nav>
      <nav class="portfolio-navigation" aria-label="More about Brent">
        <a
          class="mobile-notes"
          href={`${base}agreement/`}
          aria-current={currentPage === 'notes' ? 'page' : undefined}
        >
          Proposal notes
        </a>
        <a
          href={`${base}resume/`}
          aria-label="My Handrail resume"
          aria-current={currentPage === 'resume' ? 'page' : undefined}
        >
          <span class="desktop-link-label">My Handrail resume</span>
          <span class="mobile-link-label">My resume</span>
        </a>
        <a
          href="https://github.com/brentthomas248"
          aria-label="Explore my GitHub"
          target="_blank"
          rel="noreferrer"
          aria-describedby="new-tab-description"
        >
          <span class="desktop-link-label">Explore my GitHub</span>
          <span class="mobile-link-label">My GitHub</span>
        </a>
      </nav>
    </header>
    <span id="new-tab-description" hidden>
      Opens in a new tab.
    </span>
    <slot />
    <footer class="site-footer">
      <span>Brent Showalter for Handrail</span>
      <span>For discussion · September 2026</span>
      <a href={`${base}agreement/`}>Proposal notes</a>
      <a
        href="https://github.com/brentthomas248"
        target="_blank"
        rel="noreferrer"
        aria-describedby="new-tab-description"
      >
        My GitHub
      </a>
    </footer>
  </body>
</html>

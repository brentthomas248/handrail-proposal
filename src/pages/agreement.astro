---
import Page from '../layouts/Page.astro';
import {
  proposal,
  agreementIntro,
  agreementSections,
} from '../content/proposal';
const base = import.meta.env.BASE_URL;
---

<Page title={`${proposal.title} · Handrail × Brent Showalter`} document>
  <main id="main">
    <div class="document-header">
      <span class="document-status">
        {proposal.status} · September 26, 2026
      </span>
      <h1>{proposal.title}</h1>
      <p>
        A proposed agreement between Handrail and Brent Showalter. Complete the
        employment, benefits and legal details before signing.
      </p>
      <div class="document-tools">
        <a
          class="button button-dark"
          href={`${base}${proposal.paths.pdf}`}
          download
        >
          Download PDF <span aria-hidden="true">↓</span>
        </a>
        <a class="text-link" href={base}>
          Back to the proposal
        </a>
      </div>
    </div>
    <div class="contract-layout">
      <nav class="contract-toc" aria-label="Agreement sections">
        <p>In this agreement</p>
        <ol>
          {agreementSections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
        </ol>
      </nav>
      <article class="contract-body" aria-label="Proposed agreement text">
        <p class="contract-intro">{agreementIntro}</p>
        {agreementSections.map((section, index) => (
          <section id={section.id} class="contract-clause">
            <h2>
              {index + 1}. {section.title}
            </h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
        <p class="contract-endnote">
          End of unsigned proposal. Prepared for discussion; not an acceptance,
          signature or representation of agreed employment terms.
        </p>
      </article>
    </div>
  </main>
</Page>

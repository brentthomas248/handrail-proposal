---
import Page from '../layouts/Page.astro';
import {
  proposal,
  agreementIntro,
  agreementSections,
  agreementEndnote,
} from '../content/proposal';
const base = import.meta.env.BASE_URL;
---

<Page
  title={`Proposal notes · ${proposal.name}`}
  description="The proposed business terms: no base salary, commissions tied to customer collections and two ways to begin working together."
  document
>
  <main id="main" class="document-main">
    <header class="document-header">
      <img
        class="document-brand"
        src={`${base}handrail-logo.png`}
        width="1397"
        height="392"
        alt="Handrail"
      />
      <span class="document-status">{proposal.status} · September 2026</span>
      <h1>Proposal notes</h1>
      <p class="document-subtitle">{proposal.title}</p>
      <div class="document-tools">
        <a
          class="button button-dark"
          href={`${base}${proposal.paths.pdf}`}
          download
        >
          Download proposal
        </a>
        <a class="text-link" href={base}>
          Back to the flyer
        </a>
      </div>
    </header>
    <div class="document-layout">
      <nav class="document-toc" aria-label="Proposal sections">
        <p>In this proposal</p>
        <ol>
          {agreementSections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
        </ol>
      </nav>
      <article class="document-body" aria-label="Proposed business terms">
        <p class="document-intro">{agreementIntro}</p>
        {agreementSections.map((section, index) => (
          <section id={section.id} class="document-section">
            <h2>
              {index + 1}. {section.title}
            </h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
        <p class="document-endnote">{agreementEndnote}</p>
      </article>
    </div>
  </main>
</Page>

<style>
  @media print {
    @page {
      size: A4;
      margin: 16mm 18mm 19mm;
    }
    :global(html) {
      background: #fff !important;
    }
    :global(body.document-page) {
      background: #fff !important;
      color: #191a17 !important;
      font-size: 10pt;
    }
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    :global(.reading-progress),
    .document-toc,
    .document-tools {
      display: none !important;
    }
    .document-main,
    .document-layout,
    .document-body {
      display: block !important;
      width: auto !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .document-header {
      padding: 0 0 5mm !important;
      margin: 0 0 4mm !important;
      border-bottom: 1px solid #191a17;
    }
    .document-status {
      font-size: 8pt !important;
    }
    .document-header h1 {
      font-size: 31pt !important;
      line-height: 1.05 !important;
      margin: 3mm 0 2mm !important;
    }
    .document-subtitle {
      font-size: 11pt !important;
      margin: 0 !important;
    }
    .document-intro {
      font-size: 11pt !important;
      line-height: 1.45 !important;
      margin: 0 0 5mm !important;
    }
    .document-section {
      break-inside: avoid;
      margin: 0 0 5mm !important;
      padding: 0 !important;
      border: 0 !important;
    }
    .document-section:nth-of-type(4) {
      break-before: page;
    }
    .document-section h2 {
      font-size: 13pt !important;
      line-height: 1.2 !important;
      margin: 0 0 2mm !important;
      break-after: avoid;
    }
    .document-section p {
      font-size: 10.5pt !important;
      line-height: 1.45 !important;
      margin: 0 0 2mm !important;
      orphans: 3;
      widows: 3;
    }
    .document-endnote {
      font-size: 9pt !important;
      line-height: 1.4 !important;
      border-top: 1px solid #aaa;
      margin: 5mm 0 0 !important;
      padding: 3mm 0 0 !important;
    }
  }
</style>

---
import Page from '../layouts/Page.astro';
import SceneHost from '../components/SceneHost';
import DealPath from '../components/DealPath';
import { proposal } from '../content/proposal';
const base = import.meta.env.BASE_URL;
const examplePayment = 6000;
const money = (value: number) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(value);
---

<Page title="An agreement brought to life · Brent Showalter × Handrail">
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          <span>A commitment</span>
          <span>built around</span>
          <span>results.</span>
        </h1>
        <p class="hero-description">
          A proposal for building Handrail’s next chapter.
          <br class="desktop-break" /> Clear terms. Shared upside. Room to grow.
        </p>
        <a class="button button-dark" href="#structure">
          Explore the proposal{' '}
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 3v13m-5-5 5 5 5-5" />
          </svg>
        </a>
        <a class="hero-agreement-link text-link" href={`${base}agreement/`}>
          Read the agreement <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div
        class="sculpture-stage"
        role="img"
        aria-label="A sculptural folded agreement opening into two paths"
      >
        <SceneHost client:load />
      </div>
      <div class="hero-bottom">
        <span>Prepared by Brent Showalter for Handrail</span>
        <span class="draft-note">
          <i aria-hidden="true"></i> A proposal, open for discussion
        </span>
        <a href="#structure" class="scroll-cue">
          Unfold the details <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section
      id="structure"
      class="structure section-space"
      aria-labelledby="structure-title"
    >
      <div class="section-intro">
        <h2 id="structure-title">
          Two ways
          <br />
          to begin.
        </h2>
        <div class="intro-aside">
          <p>
            The order of commitment sets the build rate. Both paths align
            compensation with money the company actually collects.
          </p>
          <p class="muted">
            One {proposal.activationDays}-day window. The same{' '}
            {proposal.rates.recurring}% recurring rate.
          </p>
        </div>
      </div>
      <div class="paths">
        <DealPath variant="employment" />
        <DealPath variant="client" />
      </div>
      <div class="shared-terms">
        <span>Shared by both paths</span>
        <p>
          Remote employment. Benefits defined before signing. No negotiated base
          salary, with all legally required compensation preserved.
        </p>
      </div>
    </section>

    <section
      id="timeline"
      class="timeline-section section-space"
      aria-labelledby="timeline-title"
    >
      <div class="timeline-heading">
        <h2 id="timeline-title">
          A clear window.
          <br />A concrete next step.
        </h2>
        <p>
          Enough time to prove the relationship.
          <br />A defined commitment when it happens.
        </p>
      </div>
      <div class="timeline-track" aria-hidden="true">
        <div class="timeline-fill"></div>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <ol class="milestones">
        <li>
          <p class="milestone-date">Day 1</p>
          <h3>Agree on the terms.</h3>
          <p>
            Complete the open employment details and sign the final agreement.
            The window begins.
          </p>
        </li>
        <li>
          <p class="milestone-date">Through day {proposal.activationDays}</p>
          <h3>Choose the starting point.</h3>
          <p>
            Employment first sets {proposal.rates.employmentFirst}/
            {proposal.rates.recurring}. A qualifying client first sets{' '}
            {proposal.rates.clientFirst}/{proposal.rates.recurring}, with
            employment due within {proposal.hireBusinessDays} business days.
          </p>
        </li>
        <li>
          <p class="milestone-date">At the end of the window</p>
          <h3>Keep the outcome clear.</h3>
          <p>
            If neither path activates, the hiring commitment expires. Defined
            grace and commission protections preserve work already in motion.
          </p>
        </li>
      </ol>
      <details class="timeline-detail">
        <summary>
          What about a deal still in progress? <span aria-hidden="true">+</span>
        </summary>
        <div>
          <p>
            A full-build contract approved and signed by both parties by day{' '}
            {proposal.activationDays} has a proposed {proposal.graceDays}-day
            grace period for its first payment to clear. That can activate the
            client-first path.
          </p>
          <p>
            A separate {proposal.prospectTailDays}-day protection applies to
            registered prospects acknowledged by Handrail as active at expiry. A
            full-build sale that qualifies within that protection period can
            earn commission without reviving the hiring obligation outside the
            payment grace. These are proposed protections detailed in the
            agreement.
          </p>
        </div>
      </details>
    </section>

    <section
      id="collections"
      class="collections section-space"
      aria-labelledby="collections-title"
    >
      <div class="section-intro">
        <h2 id="collections-title">
          As revenue arrives,
          <br />
          compensation follows.
        </h2>
        <div class="intro-aside">
          <p>
            No commission advance on an uncollected contract. Each customer
            payment creates its corresponding commission.
          </p>
        </div>
      </div>
      <div class="payment-flow">
        <div class="payment-source">
          <span class="flow-label">Customer payment</span>
          <strong>{money(examplePayment)}</strong>
          <p>Collected build installment</p>
        </div>
        <div class="flow-bridge" aria-hidden="true">
          <span></span>
          <svg viewBox="0 0 40 20">
            <path d="M0 10h36m-7-7 7 7-7 7" />
          </svg>
        </div>
        <div class="payment-share">
          <span class="flow-label">Client-first commission</span>
          <strong>
            {money((examplePayment * proposal.rates.clientFirst) / 100)}
          </strong>
          <p>{proposal.rates.clientFirst}% of that installment</p>
        </div>
        <div class="payment-due">
          <span class="clock-dial" aria-hidden="true">
            <i></i>
          </span>
          <p>
            Paid within
            <br />
            <strong>{proposal.commissionDueDays} calendar days</strong>
            <br />
            of collection, or earlier
            <br />
            if required by law
          </p>
        </div>
      </div>
      <div class="collection-foot">
        <span>Illustrative payment, not a sales forecast.</span>
        <p>
          An installment schedule spreads commission with customer payments. It
          does not add a second 12-month deferral after the customer pays.
        </p>
      </div>
      <div class="recurring-statement">
        <span>{proposal.rates.recurring}%</span>
        <div>
          <h3>A stake in the ongoing relationship.</h3>
          <p>
            Recurring commission on credited accounts continues during
            employment and for {proposal.recurringTailMonths} months after
            separation. Deferred build commissions remain protected.
          </p>
          <a
            class="text-link"
            href={`${base}agreement/#recurring-and-deferred-rights-after-employment`}
          >
            Read the commission protections <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section
      id="partnership"
      class="partnership section-space"
      aria-labelledby="partnership-title"
    >
      <div class="section-intro">
        <h2 id="partnership-title">
          Built to work
          <br />
          together.
        </h2>
        <div class="intro-aside">
          <p>
            A strong selling relationship needs clear responsibilities and a
            practical handoff.
          </p>
        </div>
      </div>
      <div class="responsibilities">
        <article>
          <span class="responsibility-role">My commitment</span>
          <h3>
            Open the door.
            <br />
            Understand the need.
            <br />
            Earn the business.
          </h3>
          <p>
            Prospecting, discovery, relationship development and closing,
            working alongside the technical team to define a deliverable
            solution.
          </p>
        </article>
        <article>
          <span class="responsibility-role">Handrail’s commitment</span>
          <h3>
            Support the sale.
            <br />
            Scope with confidence.
            <br />
            Own the delivery.
          </h3>
          <p>
            A technical partner, timely pricing decisions, approved sales
            materials and a clear transition to implementation and continuing
            support.
          </p>
        </article>
      </div>
      <div class="completion-note">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path d="M7 4h13l5 5v19H7V4Zm13 0v6h5M11 16h10m-10 5h10" />
        </svg>
        <div>
          <h3>The details belong in writing.</h3>
          <p>
            Benefits, work state, classification, required pay and approved
            selling expenses are completion items. They are settled before
            signing, with no assumed benefits or blank terms treated as agreed.
          </p>
        </div>
      </div>
    </section>

    <section
      id="agreement"
      class="agreement-invitation section-space"
      aria-labelledby="agreement-title"
    >
      <div class="agreement-cover" aria-hidden="true">
        <div class="cover-fold"></div>
        <span>
          Brent Showalter
          <br />
          Handrail
        </span>
        <p>
          Conditional
          <br />
          employment
          <br />& commission
          <br />
          agreement.
        </p>
        <span class="cover-footer">
          Proposed terms
          <br />
          September 2026
        </span>
      </div>
      <div class="agreement-copy">
        <span class="document-status">Unsigned proposal</span>
        <h2 id="agreement-title">
          The proposal,
          <br />
          in full.
        </h2>
        <p>
          The complete agreement puts the activation rules, compensation and
          protections in one place. Ready to read, discuss and refine.
        </p>
        <div class="agreement-actions">
          <a class="button button-dark" href={`${base}agreement/`}>
            Read the full agreement <span aria-hidden="true">↗</span>
          </a>
          <a
            class="download-link"
            href={`${base}handrail-proposed-agreement.pdf`}
            download
          >
            Download PDF{' '}
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 2v10m-4-4 4 4 4-4M3 13v4h14v-4" />
            </svg>
          </a>
        </div>
        <p class="agreement-disclaimer">
          This page is a proposal, not an executed agreement. Nothing here signs
          or accepts the terms.
        </p>
      </div>
    </section>
  </main>
  <script src="../scripts/motion.ts"></script>
</Page>

---
import Page from '../layouts/Page.astro';
import DealPath from '../components/DealPath';
import CollectionComparison from '../components/CollectionComparison.astro';
import { proposal, flyerCopy } from '../content/proposal';
const base = import.meta.env.BASE_URL;
---

<Page title="A beginning together · A proposal for Handrail">
  <main id="main">
    <p class="tour-guidance sr-only">
      The animated tour follows the complete proposal below. Choose Read
      normally or Skip to content for a standard document layout.
    </p>
    <div class="tour-controls" aria-label="Proposal tour">
      <div class="tour-instruction">
        <span class="scroll-line" aria-hidden="true"></span>
        <span id="tour-caption">Scroll to open the proposal</span>
      </div>
      <nav class="chapter-nav" aria-label="Proposal chapters">
        <button
          type="button"
          data-go-to="0"
          aria-label="Overview"
          aria-current="step"
        >
          <span>Overview</span>
        </button>
      </nav>
      <span class="tour-counter" aria-hidden="true">
        <span id="current-stop">00</span> / <span id="total-stops">07</span>
      </span>
    </div>
    <div class="tour-loading">
      <p role="status">Opening the proposal</p>
      <a href={`${base}?view=read`}>Read without animation</a>
    </div>
    <div class="flyer-journey">
      <div class="flyer-stage">
        <div class="paper-shadow" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <article
          class="proposal-sheet"
          aria-label="Growth partnership proposal"
          data-fold="z-fold"
        >
          <div class="proposal-content">
            <section
              class="flyer-cover"
              id="idea"
              data-print-panel="left"
              data-camera-stop="The beginning"
              data-camera-order="1"
            >
              <p class="cover-intro">{flyerCopy.cover.eyebrow}</p>
              <h1>
                {flyerCopy.cover.headlineLines.map((line) => (
                  <span>{line}</span>
                ))}
              </h1>
              <p class="cover-statement">{flyerCopy.cover.statement}</p>
              <p class="cover-description">{flyerCopy.cover.description}</p>
            </section>
            <section
              class="flyer-cash"
              id="cash-flow"
              data-print-panel="center"
              data-camera-stop="Cash flow"
              data-camera-order="2"
            >
              <h2>{flyerCopy.cash.headline}</h2>
              <CollectionComparison id="flyer-collections" />
            </section>
            <section
              class="flyer-rates"
              id="paths"
              data-print-panel="right"
              data-camera-stop="The two paths"
              data-camera-order="3"
            >
              <div class="rates-heading">
                <h2>Two ways to begin</h2>
              </div>
              <div class="deal-paths">
                <div class="rate-group" data-camera-mobile="Hire first">
                  <h2 class="rate-context">Two ways to begin</h2>
                  <DealPath variant="employment" showScope={false} />
                  <p class="rate-scope">{flyerCopy.paths.scope}</p>
                  <p class="rate-common">{flyerCopy.paths.sharedTerms}</p>
                </div>
                <div class="rate-group" data-camera-mobile="Client first">
                  <h2 class="rate-context">Two ways to begin</h2>
                  <DealPath variant="client" showScope={false} />
                  <p class="rate-reason">{flyerCopy.paths.clientReason}</p>
                  <p class="rate-common">{flyerCopy.paths.sharedTerms}</p>
                </div>
              </div>
              <p class="rate-shared">{flyerCopy.paths.sharedTerms}</p>
            </section>
            <section
              class="flyer-window"
              id="window"
              data-camera-align="start"
              data-print-panel="right"
              data-camera-stop="The window"
              data-camera-order="4"
            >
              <div class="window-title">
                <strong aria-hidden="true">{proposal.activationDays}</strong>
                <h2 aria-label={`${proposal.activationDays} days to begin.`}>
                  days to begin.
                </h2>
              </div>
              <ol class="window-steps">
                <li>
                  <strong>Agree on the starting point.</strong>
                  <p>Define the structure and qualifying client together.</p>
                </li>
                <li>
                  <strong>Either path can start.</strong>
                  <p>
                    Handrail can hire first, or commit to hire when I bring the
                    qualifying client.
                  </p>
                </li>
                <li>
                  <strong>If neither happens.</strong>
                  <p>
                    No client and no hire by day 90: the hiring commitment ends.
                  </p>
                </li>
              </ol>
            </section>
            <section
              class="flyer-partnership"
              id="together"
              data-camera-align="start"
              data-print-panel="left"
              data-camera-stop="Grow together"
              data-camera-order="5"
            >
              <div class="partnership-lead">
                <h2>
                  {flyerCopy.closing.headlineLines.map((line) => (
                    <span>{line}</span>
                  ))}
                </h2>
              </div>
              <div class="partnership-details">
                <p>{flyerCopy.closing.startingPointBody}</p>
                <p>{flyerCopy.closing.partnershipBody}</p>
              </div>
              <div class="proposal-followup">
                <p class="proposal-note">{flyerCopy.closing.proposalNote}</p>
                <a class="proposal-link" href={`${base}agreement/`}>
                  Read the proposal notes
                </a>
              </div>
            </section>
            <section
              class="flyer-finale"
              id="lets-do-this"
              data-print-panel="right"
              data-print-face="back"
              data-camera-stop={flyerCopy.finale.headlineLines.join(' ')}
              data-camera-order="6"
            >
              <h2 aria-label={flyerCopy.finale.headlineLines.join(' ')}>
                {flyerCopy.finale.headlineLines.map((line) => (
                  <span>{line}</span>
                ))}
              </h2>
              <img
                class="closing-watermark"
                src={`${base}handrail-logo.png`}
                width="1397"
                height="392"
                alt=""
                aria-hidden="true"
              />
            </section>
          </div>
          <div class="fold-panel" data-panel="left">
            <i class="paper-edge paper-edge-top" aria-hidden="true"></i>
            <i class="paper-edge paper-edge-bottom" aria-hidden="true"></i>
            <i class="paper-edge paper-edge-outer" aria-hidden="true"></i>
            <div class="panel-face">
              <i class="paper-light" aria-hidden="true"></i>
              <i
                class="paper-crease paper-crease-right"
                data-crease="right"
                aria-hidden="true"
              ></i>
              <div class="panel-masthead">
                <img
                  class="sheet-logo"
                  src={`${base}handrail-logo.png`}
                  width="1397"
                  height="392"
                  alt="Handrail"
                />
                <span>For discussion</span>
              </div>
              <div class="panel-colophon">
                <span>Brent Showalter</span>
              </div>
            </div>
            <div class="panel-back brochure-cover" aria-hidden="true">
              <i class="paper-light" aria-hidden="true"></i>
              <i
                class="paper-crease paper-crease-left"
                data-crease="left"
                aria-hidden="true"
              ></i>
              <img
                class="sheet-logo"
                src={`${base}handrail-logo.png`}
                width="1397"
                height="392"
                alt=""
              />
              <div class="back-heading">
                New business.
                <br />
                Room to
                <br />
                grow.
              </div>
              <div class="back-statement">
                No base salary.
                <br />
                Commission follows
                <br />
                collected revenue.
              </div>
              <div class="back-footer">
                A proposal by
                <br />
                <strong>Brent Showalter</strong>
              </div>
              <span class="back-edition">For discussion / September 2026</span>
            </div>
          </div>
          <div class="fold-panel" data-panel="center">
            <i class="paper-edge paper-edge-top" aria-hidden="true"></i>
            <i class="paper-edge paper-edge-bottom" aria-hidden="true"></i>
            <div class="panel-face cash-face">
              <i class="paper-light" aria-hidden="true"></i>
              <i
                class="paper-crease paper-crease-left"
                data-crease="left"
                aria-hidden="true"
              ></i>
              <i
                class="paper-crease paper-crease-right"
                data-crease="right"
                aria-hidden="true"
              ></i>
              <div class="panel-masthead">
                <span>Collections before commission</span>
                <span>Handrail / Brent Showalter</span>
              </div>
              <div class="panel-colophon">
                <span>Commission follows collected revenue.</span>
              </div>
            </div>
            <div class="panel-back plain-back" aria-hidden="true">
              <i class="paper-light" aria-hidden="true"></i>
              <i
                class="paper-crease paper-crease-left"
                data-crease="left"
                aria-hidden="true"
              ></i>
              <i
                class="paper-crease paper-crease-right"
                data-crease="right"
                aria-hidden="true"
              ></i>
              <div>
                Handrail
                <br />
                and Brent
                <br />
                Showalter.
              </div>
              <span>A starting point for what comes next.</span>
            </div>
          </div>
          <div class="fold-panel" data-panel="right">
            <i class="paper-edge paper-edge-top" aria-hidden="true"></i>
            <i class="paper-edge paper-edge-bottom" aria-hidden="true"></i>
            <i class="paper-edge paper-edge-outer" aria-hidden="true"></i>
            <div class="panel-face">
              <i class="paper-light" aria-hidden="true"></i>
              <i
                class="paper-crease paper-crease-left"
                data-crease="left"
                aria-hidden="true"
              ></i>
              <div class="panel-masthead">
                <span>The proposed terms</span>
                <span>Handrail / Brent Showalter</span>
              </div>
              <div class="panel-colophon">
                <span>For discussion</span>
              </div>
            </div>
            <div class="panel-back closing-back" aria-hidden="true">
              <i class="paper-light" aria-hidden="true"></i>
              <i
                class="paper-crease paper-crease-right"
                data-crease="right"
                aria-hidden="true"
              ></i>
            </div>
          </div>
        </article>
      </div>
    </div>
  </main>
  <script src="../scripts/motion.ts"></script>
</Page>

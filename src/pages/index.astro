---
import Page from '../layouts/Page.astro';
import DealPath from '../components/DealPath';
import { proposal } from '../content/proposal';
const base = import.meta.env.BASE_URL;
---

<Page title="Revenue first · A proposal for Handrail">
  <main id="main">
    <div class="flyer-journey">
      <div class="flyer-stage">
        <article
          class="proposal-sheet"
          aria-label="Growth partnership proposal"
        >
          <div class="sheet-masthead">
            <img
              class="sheet-logo"
              src={`${base}handrail-logo.png`}
              width="1397"
              height="392"
              alt="Handrail"
            />
            <span>
              Growth partnership proposal
              <br />
              Brent Showalter / September 2026
            </span>
          </div>

          <section class="flyer-cover" data-camera-stop="The idea" id="idea">
            <p class="cover-intro">A different way to grow together.</p>
            <h1>
              No base
              <br />
              salary<span class="period">.</span>
            </h1>
            <p class="cover-statement">
              Commission paid from
              <br />
              collected revenue.
            </p>
            <div class="cover-bottom">
              <p>
                I build the sales pipeline.
                <br />
                Compensation follows the business.
              </p>
              <svg
                class="direction-arrow"
                viewBox="0 0 100 100"
                aria-hidden="true"
              >
                <path d="M10 50h76M53 17l34 33-34 33" />
              </svg>
            </div>
          </section>

          <section
            class="flyer-cash"
            data-camera-stop="Cash flow"
            id="cash-flow"
          >
            <div class="cash-heading">
              <span class="cash-symbol" aria-hidden="true">
                ↘
              </span>
              <h2>
                Revenue first.
                <br />
                Commission follows.
              </h2>
            </div>
            <p class="cash-intro">
              No commission advance on a contract.
              <br />
              Payment starts with money received.
            </p>
            <div
              class="cash-receipt"
              aria-label="Illustrative client-first build payment"
            >
              <div class="receipt-row receipt-in">
                <span>Customer payment collected</span>
                <strong>$10,000</strong>
              </div>
              <div class="receipt-track" aria-hidden="true">
                <span></span>
                <i></i>
                <i></i>
                <i></i>
              </div>
              <div class="receipt-row receipt-out">
                <span>20% build commission</span>
                <strong>$2,000</strong>
              </div>
              <div class="receipt-balance">
                <span>Handrail retains</span>
                <strong>$8,000</strong>
              </div>
              <p>
                Before delivery costs, benefits and other expenses.
                <br />
                An illustration, not a sales forecast.
              </p>
            </div>
            <div class="installments">
              <div class="installment-bars" aria-hidden="true">
                {Array.from({ length: 12 }, () => (
                  <i />
                ))}
              </div>
              <p>
                Paid over 12 months?
                <br />
                <strong>My commission follows each payment.</strong>
              </p>
            </div>
          </section>

          <section
            class="flyer-rates"
            data-camera-stop="The two paths"
            id="paths"
          >
            <div class="rates-heading">
              <h2>
                The order of commitment
                <br />
                sets the rate.
              </h2>
              <span class="rates-glyph" aria-hidden="true">
                ↗
              </span>
            </div>
            <div class="deal-paths">
              <div data-camera-mobile="Hire me first">
                <DealPath variant="employment" />
              </div>
              <div data-camera-mobile="Client first">
                <DealPath variant="client" />
              </div>
            </div>
            <div class="rate-rationale" data-camera-mobile="Why the difference">
              <p class="rate-reason">
                If I bring the client that makes hiring possible, the higher
                rate reflects the business I created and the risk I took to
                create it.
              </p>
              <p class="rate-scope">
                The selected rate applies to all my future credited sales. Both
                paths: no base salary, with an employment benefits package.
              </p>
            </div>
          </section>

          <section
            class="flyer-window"
            data-camera-stop="The window"
            id="window"
          >
            <div class="window-title">
              <strong>{proposal.activationDays}</strong>
              <h2>
                days
                <br />
                to begin.
              </h2>
            </div>
            <div class="window-rule" aria-hidden="true">
              <i></i>
              <span></span>
              <i></i>
            </div>
            <ol class="window-steps">
              <li>
                <strong>Agree on the structure.</strong>
                <p>
                  We align on the proposal and what qualifies as the first
                  client.
                </p>
              </li>
              <li>
                <strong>Either path can start.</strong>
                <p>
                  Handrail can hire me during the window, or I can bring the
                  paying client first.
                </p>
              </li>
              <li>
                <strong>A clear stopping point.</strong>
                <p>
                  If there is no client and no hire within 90 days, the hiring
                  commitment ends.
                </p>
              </li>
            </ol>
          </section>

          <section
            class="flyer-partnership"
            data-camera-stop="Build together"
            id="together"
          >
            <div class="partnership-lead">
              <span>
                Shared upside.
                <br />
                Clear responsibilities.
              </span>
              <h2>
                Let’s make
                <br />
                room to grow.
              </h2>
            </div>
            <div class="partnership-details">
              <div>
                <h3>I bring the business.</h3>
                <p>
                  Prospecting, discovery, relationships and closing, with
                  technical input from your team.
                </p>
              </div>
              <div>
                <h3>You help make it work.</h3>
                <p>
                  Scoping, pricing, implementation and support. We align on
                  benefits, tools and selling expenses.
                </p>
              </div>
              <p class="proposal-note">
                This is a starting point for discussion. We can adjust the
                structure together; Handrail prepares the final contract.
              </p>
              <a class="proposal-link" href={`${base}agreement/`}>
                Read the proposal notes <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
          <div class="sheet-colophon">
            <span>Prepared by Brent Showalter</span>
            <span>A proposal. Open to a conversation.</span>
            <a
              href="https://github.com/brentthomas248/handrail-proposal"
              target="_blank"
              rel="noreferrer"
            >
              Explore the source ↗
            </a>
          </div>
        </article>
      </div>
    </div>
    <div class="tour-controls" aria-label="Proposal tour">
      <div class="tour-instruction">
        <span class="scroll-line" aria-hidden="true"></span>
        <span id="tour-caption">Scroll to step inside</span>
      </div>
      <nav class="chapter-nav" aria-label="Proposal chapters">
        <button
          type="button"
          data-go-to="0"
          aria-label="Overview"
          aria-current="step"
        >
          <span>Overview</span>
        </button>
        <button type="button" data-go-to="1" aria-label="The idea">
          <span>The idea</span>
        </button>
        <button type="button" data-go-to="2" aria-label="Cash flow">
          <span>Cash flow</span>
        </button>
        <button type="button" data-go-to="3" aria-label="The two paths">
          <span>The paths</span>
        </button>
        <button type="button" data-go-to="4" aria-label="The window">
          <span>The window</span>
        </button>
        <button type="button" data-go-to="5" aria-label="Build together">
          <span>Together</span>
        </button>
      </nav>
      <span class="tour-counter" aria-hidden="true">
        <span id="current-stop">00</span> / <span id="total-stops">05</span>
      </span>
    </div>
  </main>
  <script src="../scripts/motion.ts"></script>
</Page>

        "hex": "#21568c"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.188,
          0.365,
          0.294
        ],
        "hex": "#305d4b"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.475,
          0.337,
          0.051
        ],
        "hex": "#79560d"
      }
    },
    "error": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.647,
          0.192,
          0.192
        ],
        "hex": "#a53131"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "page": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 104,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -3,
          "unit": "px"
        }
      }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 56,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -1,
          "unit": "px"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }

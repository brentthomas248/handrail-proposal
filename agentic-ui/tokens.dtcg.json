        "hex": "#20272d"
      }
    },
    "on-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.325,
          0.376,
          0.42
        ],
        "hex": "#53606b"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.78,
          0.808,
          0.831
        ],
        "hex": "#c7ced4"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.129,
          0.337,
          0.549

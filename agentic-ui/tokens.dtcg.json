{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A scroll-directed tour through a real proposal flyer, using Handrail's warm editorial identity.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.784, 0.314, 0.165],
        "hex": "#c8502a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.42, 0.384, 0.345],
        "hex": "#6b6258"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.922, 0.894, 0.847],
        "hex": "#ebe4d8"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.984, 0.98, 0.969],
        "hex": "#fbfaf7"
      }
    },
    "on-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.102, 0.094, 0.086],
        "hex": "#1a1816"
      }
    },
    "on-primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "on-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.42, 0.384, 0.345],
        "hex": "#6b6258"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.714, 0.667, 0.6],
        "hex": "#b6aa99"
      }
    },
    "focus": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.102, 0.094, 0.086],
        "hex": "#1a1816"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "page": {
      "$value": {
        "value": 90,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 30,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "headline-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter Variable",
        "fontSize": {
          "value": 190,
          "unit": "px"
        },
        "fontWeight": 760,
        "letterSpacing": {
          "value": -14.25,
          "unit": "px"
        }
      }
    },
    "headline-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter Variable",
        "fontSize": {
          "value": 64,
          "unit": "px"
        },
        "fontWeight": 550,
        "letterSpacing": {
          "value": -3.328,
          "unit": "px"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter Variable",
        "fontSize": {
          "value": 31,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.682,
          "unit": "px"
        }
      }
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter Variable",
        "fontSize": {
          "value": 23,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "introduction": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Playfair Display",
        "fontSize": {
          "value": 31,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}

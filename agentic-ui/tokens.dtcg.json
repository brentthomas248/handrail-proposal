{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A sculptural, readable proposal whose folded paper becomes its deal structure.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.129,
          0.212,
          0.294
        ],
        "hex": "#21364b"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.384,
          0.482,
          0.553
        ],
        "hex": "#627b8d"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.635,
          0.678,
          0.714
        ],
        "hex": "#a2adb6"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.929,
          0.941,
          0.949

{
  "name": "handrail-proposal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "contract:generate": "node scripts/generate-contract.ts",
    "contract:check": "node scripts/generate-contract.ts --check",
    "pdf": "node scripts/generate-pdf.mjs",
    "build:release": "pnpm contract:check && pnpm build && pnpm pdf",
    "capture": "node scripts/capture.mjs",
    "test:components": "node .storybook/verify-components.mjs",
    "pdf:check": "node scripts/verify-pdf.ts",
    "social:generate": "node scripts/generate-social.mjs",
    "format": "prettier --write src scripts tests *.ts .storybook docs/github-actions",
    "format:check": "prettier --check src scripts tests *.ts .storybook docs/github-actions",
    "performance": "node scripts/performance.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "oxc-transform-react": "0.145.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
